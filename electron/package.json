{
  "name": "@kaoyan-english-lab/electron",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kaoyan.englishlab",
    "productName": "Kaoyan English Lab",
    "asar": false,
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "../backend/**/*",
      "../frontend/dist/**/*",
      "../scripts/**/*",
      "../package.json",
      "../README.md",
      "../LICENSE"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
